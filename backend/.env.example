PORT=3000
NODE_ENV=development

# Public app setting; this URL is embedded in the mobile app.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-splenexa-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-splenexa-project-public-anon-key

# Server-only Supabase credentials. Do not use the anon key here.
SUPABASE_URL=https://your-splenexa-project.supabase.co
SUPABASE_SECRET_KEY=your-splenexa-project-server-only-secret-key
# Production requires the non-JWT SUPABASE_SECRET_KEY; the legacy JWT service-role key is not accepted.

# MSG91 server-side OTP Widget credentials.
MSG91_AUTHKEY=your-msg91-auth-key
MSG91_WIDID=your-msg91-widget-id
# MSG91_TOKENAUTH is for client-side widget integration; the backend does not use it.

# Generate a unique, random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Razorpay credentials are server-only. Never add these to the mobile app or admin frontend.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Set to true only after test-mode checkout and payment verification pass in production.
RAZORPAY_ALLOW_LIVE=false
